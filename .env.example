# ==============================================================================
# PATCHPILOT AI — ROOT ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env (or backend/.env and frontend/.env.local)
# 2. Never commit actual secret keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PHASE 1: ACTIVE / REQUIRED FOR LOCAL FOUNDATION
# ------------------------------------------------------------------------------

# FastAPI Backend Settings
ENVIRONMENT=development
PROJECT_NAME="PatchPilot API"
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Connection (PostgreSQL with psycopg v3 driver)
# Note: In Phase 1, the basic /api/health endpoint responds even if the database is offline.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/patchpilot

# Next.js Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# PHASE 3: ACTIVE FOR BACKEND & GITHUB INTEGRATION
# ------------------------------------------------------------------------------

# Redis Foundation (Cache & Message Broker)
REDIS_URL=redis://localhost:6379/0

# Security (JWT / session cookie encryption)
SECRET_KEY=replace-with-a-secure-random-secret-in-production

# Phase 3 — GitHub Integration
# Register an OAuth App in GitHub Developer Settings:
# Authorization callback URL: http://localhost:3000/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/github/callback
GITHUB_API_BASE_URL=https://api.github.com

# ------------------------------------------------------------------------------
# FUTURE PHASES: ARCHITECTURAL PLACEHOLDERS (NOT ACTIVE IN PHASE 3)
# ------------------------------------------------------------------------------

# Phase 4 — Agentic AI Engine (Multi-Agent Patch Generation & Analysis)
# AI_MODE=static requires no key and runs deterministic rule-based analysis.
# AI_MODE=llm calls any OpenAI-compatible chat completions endpoint - OpenAI,
# Azure OpenAI, or a self-hosted vLLM server such as AMD Developer Cloud /
# ROCm (e.g. AI_BASE_URL=http://<host>:8000/v1).
AI_MODE=static
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=30

# Phase 6 — LLM Runtime Integration
# Completes the "LLM_*" configuration surface without duplicating the four
# settings above: LLM_MODEL=AI_MODEL, LLM_API_KEY=AI_API_KEY,
# LLM_BASE_URL=AI_BASE_URL, LLM_TIMEOUT_SECONDS=AI_REQUEST_TIMEOUT_SECONDS.
LLM_PROVIDER=openai
LLM_MAX_TOKENS=1024
