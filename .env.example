# ==============================================================================
# PATCHPILOT AI — ROOT ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env (or backend/.env and frontend/.env.local)
# 2. Never commit actual secret keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PHASE 1: ACTIVE / REQUIRED FOR LOCAL FOUNDATION
# ------------------------------------------------------------------------------

# FastAPI Backend Settings
ENVIRONMENT=development
PROJECT_NAME="PatchPilot API"
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Connection (PostgreSQL with psycopg v3 driver)
# Note: In Phase 1, the basic /api/health endpoint responds even if the database is offline.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/patchpilot

# Next.js Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# FUTURE PHASES: ARCHITECTURAL PLACEHOLDERS (NOT ACTIVE IN PHASE 1)
# ------------------------------------------------------------------------------

# Phase 4 — Background Agent Task Queue (Redis)
REDIS_URL=redis://localhost:6379/0

# Phase 5 — Authentication & Session Management
SECRET_KEY=replace-with-a-secure-random-secret-in-future-phases

# Phase 5 — GitHub Developer App Integration (OAuth & Repo Synchronization)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Phase 6 — Agentic AI Engine (Multi-Agent Patch Generation & Analysis)
AI_API_KEY=
