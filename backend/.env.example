# PatchPilot Backend Environment Variables (.env.example)

ENVIRONMENT=development
PROJECT_NAME="PatchPilot API"
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL with psycopg v3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/patchpilot

# Future Phases (Reserved / Inactive in Phase 1)
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-a-secure-random-secret-in-future-phases
AI_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
