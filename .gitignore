# PatchPilot AI — Root .gitignore

# Python virtual environments & bytecode
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node & Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
.turbo/
build/
dist/

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env.local
frontend/.env.*.local
backend/.env
backend/.env.local

# Allow example files
!.env.example
!frontend/.env.example
!backend/.env.example

# Logs & temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & local runtime data
*.sqlite3
*.db

# Operating System & IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
